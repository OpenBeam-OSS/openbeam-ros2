# Copy to .env and fill in ONE of the connection blocks.

# A) A game on this machine, started with ROR_AGENT_PORT=0 and
#    ROR_AGENT_ENDPOINT_FILE=<path>. The bridge reads host, port and token from it.
#OPENBEAM_ENDPOINT_DIR=/absolute/path/to/the/folder/holding/it
#OPENBEAM_ENDPOINT_NAME=agent-endpoint.json
#    Docker Desktop reaches the host's loopback as host.docker.internal (default).
#OPENBEAM_ENDPOINT_HOST=host.docker.internal

# B) A hosted session (Play OpenBeam in the browser, keep it open).
#    The token comes from `openbeam-login` (device sign-in), stored in a file.
#OPENBEAM_SESSION_ID=your-session-id
#OPENBEAM_MCP_TOKEN_FILE=/absolute/path/to/openbeam-token

# C) No game at all: a kinematic stand-in arm.
#OPENBEAM_BACKEND=fake

# Rates
#STATE_RATE_HZ=60
#CAMERA_RATE_HZ=0.5
#ROS_DOMAIN_ID=42
